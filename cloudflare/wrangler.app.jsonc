// Lagekit komplett auf Cloudflare: statischer Export aus out/ und Kurzcode-Dienst
// in einem Worker. Bereitstellen: pnpm build && pnpm exec wrangler deploy -c cloudflare/wrangler.app.jsonc
// Nur den Kurzcode-Dienst (App z. B. auf Vercel): wrangler.jsonc im Wurzelordner
// Anleitung: docs/betrieb/cloudflare.md
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lagekit",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "../out",
    "binding": "ASSETS",
    // /hinweise/ → /hinweise/index.html wie trailingSlash im Export; 404.html für Unbekanntes.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/konfiguration.json"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VERMITTLUNG", "class_name": "Vermittlung" }]
  },
  "ratelimits": [{ "name": "GRENZE", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vermittlung"] }],
  "observability": { "enabled": false }
}
