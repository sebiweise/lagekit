// Cloudflare Worker nur mit dem Kurzcode-Dienst; die App läuft woanders (z. B. Vercel).
// Bereitstellen: pnpm exec wrangler deploy -c cloudflare/wrangler.jsonc
// Anleitung: docs/betrieb/cloudflare.md
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lagekit-kurzcode",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "VERMITTLUNG", "class_name": "Vermittlung" }]
  },
  // Durable Objects mit SQLite-Speicher gibt es auch im Free-Plan.
  // Grenze pro IP-Adresse, bevor das Durable Object arbeitet. Mit Long-Polling braucht
  // ein Gerät nur wenige Aufrufe pro Minute; alle Geräte eines ELW teilen sich oft eine IP.
  "ratelimits": [{ "name": "GRENZE", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Vermittlung"] }],
  // Keine Logs: Cloudflare soll keine Aufrufe mit IP-Adressen speichern.
  "observability": { "enabled": false }
}
